# ==============================================================================
# Existence - Backend Environment Configuration (Prompt 02 Standard)
# ==============================================================================

# Application Identity & Mode
APP_NAME="Existence"
APP_ENV="development"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# Security & Authentication (Generate a cryptographically secure 64-char hex in production)
JWT_SECRET_KEY="existence_production_secret_key_change_me_before_deploying_min_32_chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# PIN Security Policy (Sensitive Content & Destructive Actions)
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# Database Connectivity
# Local Development (SQLite):
DATABASE_URL="sqlite:///./existence.db"
# Production (Render / Neon / Supabase PostgreSQL with Psycopg 3):
# DATABASE_URL="postgresql+psycopg://username:password@hostname:5432/existence_db"

# Network & CORS Configuration (Comma-separated list of allowed origins)
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://*.vercel.app,https://*.onrender.com"

# Initial Administrator Bootstrap (Applied ONLY when database contains zero users)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@existence.internal"
ADMIN_PASSWORD="Admin@Existence2026!"
